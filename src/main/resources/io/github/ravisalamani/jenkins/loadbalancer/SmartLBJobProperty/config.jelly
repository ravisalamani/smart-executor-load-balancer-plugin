<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:section title="Smart Load Balancer">
    <f:entry title="Disable Smart Load Balancer"
             description="Use Jenkins default scheduling for this job instead of fault-aware load balancing.">
      <f:checkbox name="disableSmartLB" checked="${instance.disableSmartLB}"/>
    </f:entry>
  </f:section>
</j:jelly>
